# Copy to .env and fill in. The app uses the LIVE PostgreSQL database in both
# development and production — do not point this at a local server, and do not
# override DATABASE_URL in .env.local (Next.js loads .env.local first).
# Runtime endpoint. Through a transaction pooler (Neon -pooler, Supabase :6543,
# PgBouncer) you MUST set pgbouncer=true so Prisma stops using prepared
# statements, which the pooler cannot keep alive between queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=15&connect_timeout=10"

# Direct (non-pooled) endpoint, used only by Prisma Migrate, which needs a real
# session. On Neon this is the same host without the "-pooler" suffix.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connect_timeout=10"

# npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_SIZE_MB="20"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Only needed for the one-off MySQL -> PostgreSQL data transfer.
# MYSQL_URL="mysql://root:@127.0.0.1:3306/aquen_cms"
