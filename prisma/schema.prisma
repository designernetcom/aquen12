generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through the connection pooler (pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrations need a real session, which transaction pooling cannot provide,
  // so they use the provider's direct endpoint.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  HERO
  OVERVIEW
  DESCRIPTION
  GALLERY
  FEATURES
  BENEFITS
  SPECIFICATIONS
  APPLICATIONS
  PROCESS
  FAQ
  CTA
  DOWNLOADS
  RELATED
  CUSTOM
}

enum ProjectStatus {
  DRAFT
  ONGOING
  COMPLETED
  ARCHIVED
}

enum MediaType {
  IMAGE
  SVG
  PDF
  VIDEO
  DOCUMENT
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String               @db.VarChar(120)
  email               String               @unique @db.VarChar(191)
  phone               String?              @db.VarChar(30)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  roleId              Int                  @map("role_id")
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status              UserStatus           @default(ACTIVE)
  profileImageId      Int?                 @map("profile_image_id")
  profileImage        Media?               @relation("ProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  lastLoginAt         DateTime?            @map("last_login_at")
  passwordResetTokens PasswordResetToken[]
  uploadedMedia       Media[]              @relation("UploadedMedia")
  activityLogs        ActivityLog[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")

  @@index([roleId, status])
  @@index([deletedAt])
  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model MediaFolder {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(120)
  slug      String        @unique @db.VarChar(191)
  parentId  Int?          @map("parent_id")
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  media     Media[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("media_folders")
}

model Media {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(191)
  fileName       String                @map("file_name") @db.VarChar(191)
  url            String                @db.VarChar(500)
  mimeType       String                @map("mime_type") @db.VarChar(100)
  type           MediaType
  size           Int
  altText        String?               @map("alt_text") @db.VarChar(255)
  caption        String?               @db.Text
  folderId       Int?                  @map("folder_id")
  folder         MediaFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedById   Int?                  @map("uploaded_by_id")
  uploadedBy     User?                 @relation("UploadedMedia", fields: [uploadedById], references: [id], onDelete: SetNull)
  profileFor     User[]                @relation("ProfileImage")
  categoryIcons  SolutionCategory[]    @relation("CategoryIcon")
  categoryImages SolutionCategory[]    @relation("CategoryImage")
  categoryOgs    SolutionCategory[]    @relation("CategoryOg")
  subThumbnails  SolutionSubcategory[] @relation("SubThumbnail")
  subOgs         SolutionSubcategory[] @relation("SubOg")
  pageOgs        SolutionPage[]        @relation("PageOg")
  projectImages  Project[]             @relation("ProjectImage")
  industryImages Industry[]            @relation("IndustryImage")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")

  @@index([folderId, type])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("media")
}

model SolutionCategory {
  id              Int                   @id @default(autoincrement())
  name            String                @db.VarChar(191)
  slug            String                @unique @db.VarChar(191)
  description     String?               @db.Text
  iconId          Int?                  @map("icon_id")
  icon            Media?                @relation("CategoryIcon", fields: [iconId], references: [id], onDelete: SetNull)
  imageId         Int?                  @map("image_id")
  image           Media?                @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder       Int                   @default(0) @map("sort_order")
  isEnabled       Boolean               @default(true) @map("is_enabled")
  status          ContentStatus         @default(DRAFT)
  seoTitle        String?               @map("seo_title") @db.VarChar(191)
  metaDescription String?               @map("meta_description") @db.VarChar(320)
  metaKeywords    String?               @map("meta_keywords") @db.Text
  canonicalUrl    String?               @map("canonical_url") @db.VarChar(500)
  ogImageId       Int?                  @map("og_image_id")
  ogImage         Media?                @relation("CategoryOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  robots          String?               @db.VarChar(100)
  subcategories   SolutionSubcategory[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")

  @@index([isEnabled, status, sortOrder])
  @@index([deletedAt])
  @@map("solution_categories")
}

model SolutionSubcategory {
  id              Int              @id @default(autoincrement())
  categoryId      Int              @map("category_id")
  category        SolutionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String           @db.VarChar(191)
  slug            String           @db.VarChar(191)
  description     String?          @db.Text
  thumbnailId     Int?             @map("thumbnail_id")
  thumbnail       Media?           @relation("SubThumbnail", fields: [thumbnailId], references: [id], onDelete: SetNull)
  sortOrder       Int              @default(0) @map("sort_order")
  isEnabled       Boolean          @default(true) @map("is_enabled")
  status          ContentStatus    @default(DRAFT)
  seoTitle        String?          @map("seo_title") @db.VarChar(191)
  metaDescription String?          @map("meta_description") @db.VarChar(320)
  metaKeywords    String?          @map("meta_keywords") @db.Text
  canonicalUrl    String?          @map("canonical_url") @db.VarChar(500)
  ogImageId       Int?             @map("og_image_id")
  ogImage         Media?           @relation("SubOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  pages           SolutionPage[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  @@unique([categoryId, slug])
  @@index([categoryId, isEnabled, status, sortOrder])
  @@index([deletedAt])
  @@map("solution_subcategories")
}

model SolutionPage {
  id              Int                 @id @default(autoincrement())
  subcategoryId   Int                 @map("subcategory_id")
  subcategory     SolutionSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  title           String              @db.VarChar(191)
  slug            String              @db.VarChar(191)
  excerpt         String?             @db.Text
  sortOrder       Int                 @default(0) @map("sort_order")
  status          ContentStatus       @default(DRAFT)
  publishedAt     DateTime?           @map("published_at")
  seoTitle        String?             @map("seo_title") @db.VarChar(191)
  metaDescription String?             @map("meta_description") @db.VarChar(320)
  metaKeywords    String?             @map("meta_keywords") @db.Text
  canonicalUrl    String?             @map("canonical_url") @db.VarChar(500)
  ogImageId       Int?                @map("og_image_id")
  ogImage         Media?              @relation("PageOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  twitterCard     String?             @map("twitter_card") @db.VarChar(50)
  schemaJson      Json?               @map("schema_json")
  robots          String?             @db.VarChar(100)
  sections        PageSection[]
  relatedFrom     RelatedSolution[]   @relation("RelatedFrom")
  relatedTo       RelatedSolution[]   @relation("RelatedTo")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")

  @@unique([subcategoryId, slug])
  @@index([status, publishedAt, sortOrder])
  @@index([deletedAt])
  @@map("solution_pages")
}

model PageSection {
  id        Int          @id @default(autoincrement())
  pageId    Int          @map("page_id")
  page      SolutionPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      SectionType
  title     String?      @db.VarChar(191)
  content   Json
  sortOrder Int          @default(0) @map("sort_order")
  isEnabled Boolean      @default(true) @map("is_enabled")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([pageId, isEnabled, sortOrder])
  @@map("page_sections")
}

model RelatedSolution {
  pageId        Int          @map("page_id")
  relatedPageId Int          @map("related_page_id")
  sortOrder     Int          @default(0) @map("sort_order")
  page          SolutionPage @relation("RelatedFrom", fields: [pageId], references: [id], onDelete: Cascade)
  relatedPage   SolutionPage @relation("RelatedTo", fields: [relatedPageId], references: [id], onDelete: Cascade)

  @@id([pageId, relatedPageId])
  @@index([relatedPageId])
  @@map("related_solutions")
}

model Project {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(191)
  slug        String        @unique @db.VarChar(191)
  summary     String?       @db.Text
  content     Json?
  status      ProjectStatus @default(DRAFT)
  industryId  Int?          @map("industry_id")
  industry    Industry?     @relation(fields: [industryId], references: [id], onDelete: SetNull)
  imageId     Int?          @map("image_id")
  image       Media?        @relation("ProjectImage", fields: [imageId], references: [id], onDelete: SetNull)
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  @@index([status, industryId])
  @@index([deletedAt])
  @@map("projects")
}

model Industry {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  description String?   @db.Text
  imageId     Int?      @map("image_id")
  image       Media?    @relation("IndustryImage", fields: [imageId], references: [id], onDelete: SetNull)
  sortOrder   Int       @default(0) @map("sort_order")
  isEnabled   Boolean   @default(true) @map("is_enabled")
  projects    Project[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([isEnabled, sortOrder])
  @@map("industries")
}

model Navigation {
  id        Int          @id @default(autoincrement())
  label     String       @db.VarChar(120)
  href      String?      @db.VarChar(500)
  location  String       @db.VarChar(50)
  parentId  Int?         @map("parent_id")
  parent    Navigation?  @relation("NavigationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Navigation[] @relation("NavigationTree")
  sortOrder Int          @default(0) @map("sort_order")
  isEnabled Boolean      @default(true) @map("is_enabled")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([location, parentId, isEnabled, sortOrder])
  @@map("navigation")
}

model Setting {
  id        Int      @id @default(autoincrement())
  group     String   @db.VarChar(80)
  key       String   @unique @db.VarChar(120)
  value     Json
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group, isPublic])
  @@map("settings")
}

model ActivityLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(50)
  entityType String?  @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("activity_logs")
}
